*.pdf
# P4-08B one-shot import corpus for App Platform release (A–C file writes).
!scripts/_p4_08b_import_files/
!scripts/_p4_08b_import_files/**
!scripts/_p4_08b_import_files/**/*.pdf
!scripts/_p4_08b_import_files/**/*.jpg
!scripts/_p4_08b_import_files/**/*.JPG
!scripts/_p4_08b_import_files/**/*.jpeg
*.xlsx
*.xls
*.docx
*.DOCX
*.pptx
*.msg
*.dymo
*.zip

# Auditor portal. The 2026 external audit is closed and its 683 documents have been
# archived off-repo (see Auditor Files/README.md for the location and the manifest).
#
# Portal documents are deliberately NOT tracked. Committing them previously put ~649 MB
# into every clone and every Docker build. The blanket *.pdf / *.docx / *.xlsx rules above
# now apply inside this folder too, and only the folder skeleton is tracked.
#
# Do NOT re-add `!Auditor Files/**` to support a future audit. Serving portal documents
# from Spaces is the supported path — see docs/SYSTEM_OVERVIEW.md.
Auditor Files/**
!Auditor Files/.gitkeep
!Auditor Files/README.md
# eQMS document staging (binaries not committed)
eQMS_Upload_Staging/document_control/
eQMS_Upload_Staging/records/
!eQMS_Upload_Staging/reconciliation/

# Local dev-only import corpus (never committed)
dev_local.db
dev_local_storage/

# Retired one-off operator scripts. Many embed live production credentials, so the
# whole folder stays local. See archive/README.md before resurrecting anything here.
/archive/local-only/

# Local working artifacts: data exports, generated spreadsheets, documents staged
# for upload through the app. Never part of the deployable system.
/working-files/

# New one-off operator scripts that embed live credentials must be added here
# individually (scripts/ is otherwise tracked).
scripts/_cleanup_prod.py
